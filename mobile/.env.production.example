# Template for testing the mobile app against the DEPLOYED backend instead of
# the local emulators. Copy to .env (or overwrite the relevant lines in your
# existing .env) once functions are deployed — see the root README's
# "Deploying" section for the full walkthrough.
#
# No EAS Build / app store profile exists yet — this only covers pointing a
# locally-run Expo app at production. A real production build pipeline is a
# separate, later task.

# --- Firebase Web app config: same values as .env.example, unchanged ---
EXPO_PUBLIC_FIREBASE_API_KEY=REQUIRED_paste_web_api_key
EXPO_PUBLIC_FIREBASE_APP_ID=REQUIRED_paste_web_app_id
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=nourish-22776.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nourish-22776
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=nourish-22776.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=805682326779

# --- The two values that actually change for production ---

# Paste the exact URL `firebase deploy` prints for the `api` function.
# Do not guess the hostname format yourself — copy it verbatim from the
# deploy output (1st-gen and 2nd-gen Cloud Functions URLs differ).
EXPO_PUBLIC_API_BASE_URL=REQUIRED_paste_deployed_function_url

# false = use real Firebase Auth + the deployed function, not the emulator.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

# Irrelevant when USE_FIREBASE_EMULATOR is false; left for symmetry with
# .env.example.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
