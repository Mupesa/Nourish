# Copy to .env and fill in the two values marked REQUIRED.
# Expo inlines EXPO_PUBLIC_* vars at build time. Restart `expo start -c` after edits.

# --- Firebase Web app config (Console > Project settings > Your apps > Web) ---
EXPO_PUBLIC_FIREBASE_API_KEY=REQUIRED_paste_web_api_key
EXPO_PUBLIC_FIREBASE_APP_ID=REQUIRED_paste_web_app_id

# These are already correct for project nourish-22776 (override only if needed):
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=nourish-22776.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nourish-22776
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=nourish-22776.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=805682326779

# --- API base URL ---
# Functions emulator on a physical phone: use your computer's LAN IP, not localhost.
# Find it with `ipconfig` (IPv4 Address). Example:
#   http://192.168.1.10:5001/nourish-22776/us-central1/api
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/nourish-22776/us-central1/api

# --- Dev emulator wiring ---
# When true, the app uses the local Firebase Auth emulator (tokens then match
# the Functions emulator). Set false for production (real Auth + deployed API).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
# Host where emulators run. Use your PC's LAN IP for a physical phone.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
