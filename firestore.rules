rules_version = '2';

// Nourish Firestore Security Rules
// Principle: all user data is private to its owner. Writes that affect computed
// values (TDEE, calorie totals) are funnelled through the backend (Admin SDK,
// which bypasses these rules). The client may READ its own data directly for
// real-time UI, but is not trusted to WRITE derived fields.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- User profiles ----
    // Read: owner only. Write: blocked from client (backend writes via Admin SDK)
    // so that server-computed targets (dailyGoalKcal, macros) cannot be forged.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      // Daily diary entries: owner can read directly for real-time display.
      // Writes go through the backend so totals stay authoritative.
      match /diaryEntries/{date} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ---- Recipes (Phase 2) ----
    // Approved recipes are world-readable; only backend writes.
    match /recipes/{recipeId} {
      allow read: if resource.data.status == 'approved';
      allow write: if false;
    }

    // ---- Social (Phase 3) ----
    // Public profiles + the handle index are readable by any signed-in user
    // (needed for friend lookups/search). All writes go through the backend, so
    // streak/handle/counts cannot be forged. Posts, friend graph, reports and
    // the phone index are backend-only and fall through to the default deny.
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /handles/{handle} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
