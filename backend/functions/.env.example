# Copy to .env for local emulator runs. NEVER commit the real .env.
# In production, set these with: firebase functions:secrets:set SPOONACULAR_API_KEY

# Spoonacular API key (https://spoonacular.com/food-api). Used for Quick Meal
# nutrition lookups. Free tier = 150 points/day.
SPOONACULAR_API_KEY=your_spoonacular_key_here
